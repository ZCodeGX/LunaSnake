import juego.config
import list
import string

pub fn crear():
    let y = int(config.ALTO / 2)
    return { cuerpo = [{ x = 0, y = y }, { x = 1, y = y }, { x = 2, y = y }], dir = "d" }

pub fn cambiar(snake, texto):
    let tecla = string.sub(string.lower(texto), 0, 1)
    if tecla == "w":
        if snake.dir == "s":
            return false
    else:
        if tecla == "s":
            if snake.dir == "w":
                return false
        else:
            if tecla == "a":
                if snake.dir == "d":
                    return false
            else:
                if tecla == "d":
                    if snake.dir == "a":
                        return false
                else:
                    return false
    snake.dir = tecla
    return true

pub fn destino(snake, dir, ancho, alto):
    let ultimo = len(snake.cuerpo) - 1
    let x = snake.cuerpo[ultimo].x
    let y = snake.cuerpo[ultimo].y
    if dir == "w":
        y -= 1
    else:
        if dir == "s":
            y += 1
        else:
            if dir == "a":
                x -= 1
            else:
                x += 1
    if x < 0 or x >= ancho or y < 0 or y >= alto:
        return nil
    return { x = x, y = y }

pub fn ocupa(snake, x, y, permitir_cola):
    let limite = len(snake.cuerpo)
    let i = 0
    if permitir_cola:
        i = 1
    while i < limite:
        if snake.cuerpo[i].x == x and snake.cuerpo[i].y == y:
            return true
        i += 1
    return false

pub fn mover(snake, comida, ancho, alto):
    let siguiente = destino(snake, snake.dir, ancho, alto)
    if siguiente == nil:
        return { vivo = false, comio = false, razon = "muro" }
    let comio = siguiente.x == comida.x and siguiente.y == comida.y
    if ocupa(snake, siguiente.x, siguiente.y, not comio):
        return { vivo = false, comio = false, razon = "cuerpo" }
    if not comio:
        snake.cuerpo = list.slice(snake.cuerpo, 1, len(snake.cuerpo))
    list.push(snake.cuerpo, siguiente)
    return { vivo = true, comio = comio, razon = "" }
